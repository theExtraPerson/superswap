# SuperSwap — environment (copy to .env.local)
# Supabase project settings (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # safe in the browser; RLS still applies

# Server only — NEVER expose to the browser and never ship a NEXT_PUBLIC_ prefix.
# Used ONLY by /api/settle (the settlement cron), which is itself guarded by CRON_SECRET.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bearer token for POST /api/settle (Vercel Cron / any scheduler).
CRON_SECRET=pick-a-long-random-string

# Public origin. Used for auth redirect URLs AND as metadataBase, so shared
# referral links resolve to absolute og:url / og:image. On Vercel set it to
# https://superswap-nine.vercel.app — a stale or localhost value produces share
# cards that preview fine but link nowhere useful.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shashura payments gateway — server only (https://shashura.com/developers).
# Merchant dashboard → Settings → API Access. Without CLIENT_ID+SECRET the
# gateway buttons on the admin desk answer 503; manual settlement keeps working.
SHASHURA_CLIENT_ID=PID_5788615441adf4bbb7cadf3ef315dde2
SHASHURA_CLIENT_SECRET=
SHASHURA_TARGET_ENV=production         
SHASHURA_BASE_URL=https://shashura.com/api/v1
# Per-app signing secret for the transaction.finalized webhook that Shashura
# POSTs to /api/shashura/callback (Settings → Apps). Unset = webhook disabled.
SHASHURA_WEBHOOK_SECRET=PSK_e0378f9b995be724dfed533823703b25bc38269182b06734761c8808ba7f700f
